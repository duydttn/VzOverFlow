[Unit]
Description=VzOverFlow .NET Web Application
After=network.target

[Service]
WorkingDirectory=/root/vzstackoverflow/www/vzoverflow
ExecStart=/usr/bin/dotnet /root/vzstackoverflow/www/vzoverflow/VzOverFlow.dll
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=vzoverflow
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://localhost:5050
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target