@using VzOverFlow.Models.ViewModels
@model UserMiniCardViewModel
@{
    string userName = Model.UserName;
    int userId = Model.UserId;
    string avatarUrl = !string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : $"https://api.dicebear.com/7.x/avataaars/svg?seed={userName}";
    int reputation = Model.UserReputation;
    string? bio = Model.Bio;
}

<div class="bg-white border border-slate-200 rounded-xl shadow-2xl p-4 w-64 text-left pointer-events-auto">
    <div class="flex items-start gap-3 mb-3">
        <img src="@avatarUrl" alt="@userName" class="w-12 h-12 rounded-lg object-cover bg-slate-100 border border-slate-100 shadow-sm" />
        <div class="flex-1 min-w-0">
            <h4 class="font-bold text-slate-900 text-sm truncate">@userName</h4>
            <div class="flex items-center gap-1.5 mt-0.5">
                <span class="font-black text-slate-700 text-xs">@reputation.ToString("N0")</span>
                <span class="text-[9px] uppercase tracking-wider text-slate-400 font-bold">Uy tín</span>
            </div>
            <div class="flex gap-2 mt-1.5">
                <div class="flex items-center gap-0.5" title="Vàng">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <span class="text-[9px] font-bold text-slate-500">0</span>
                </div>
                <div class="flex items-center gap-0.5" title="Bạc">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
                    <span class="text-[9px] font-bold text-slate-500">0</span>
                </div>
                <div class="flex items-center gap-0.5" title="Đồng">
                    <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
                    <span class="text-[9px] font-bold text-slate-500">0</span>
                </div>
            </div>
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(bio))
    {
        <div class="border-t border-slate-100 pt-2 mb-3">
            <p class="text-[10px] text-slate-500 line-clamp-2 italic leading-relaxed">
                @bio
            </p>
        </div>
    }
    
    <div class="mt-3">
        <a href="/users/profile/@userId" class="block w-full text-center py-1.5 bg-slate-50 hover:bg-blue-50 text-blue-600 text-[10px] font-bold rounded flex items-center justify-center gap-1 transition-colors border border-slate-100">
            Xem hồ sơ
            <svg class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/></svg>
        </a>
    </div>
</div>
