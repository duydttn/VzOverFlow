<aside class="hidden lg:block lg:col-span-3 border-l border-slate-200 min-h-[calc(100vh-4rem)]">
    <div class="space-y-4 sticky top-20 px-4 py-6">
        @if (User.Identity?.IsAuthenticated == true)
        {
            @await Component.InvokeAsync("DailyMissions")
        }

        <section class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
            <h2 class="text-sm font-semibold text-slate-800 mb-3 flex items-center gap-2">
                <svg class="h-4 w-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                VzOverFlow
            </h2>
            <div class="grid grid-cols-2 gap-3 text-center">
                <div class="bg-slate-50 rounded-lg p-3">
                    <div class="text-2xl font-bold text-slate-900">@Model.TotalQuestions</div>
                    <div class="text-[10px] text-slate-500 uppercase tracking-wide">Câu hỏi</div>
                </div>
                <div class="bg-slate-50 rounded-lg p-3">
                    <div class="text-2xl font-bold text-slate-900">@Model.TotalAnswers</div>
                    <div class="text-[10px] text-slate-500 uppercase tracking-wide">Câu trả lời</div>
                </div>
            </div>
        </section>

        <section class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
            <h2 class="text-sm font-semibold text-slate-800 mb-3 flex items-center gap-2">
                <svg class="h-4 w-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                Chủ đề phổ biến
            </h2>
            <div class="flex flex-wrap gap-1.5 text-[11px]">
                @foreach (var tag in Model.PopularTags)
                {
                    <a asp-controller="Questions" asp-action="Index" asp-route-tag="@tag.Name"
                       class="rounded bg-blue-50 px-2 py-1 text-blue-700 hover:bg-blue-100 transition-colors flex items-center gap-1.5 border border-blue-100">
                        <span class="font-medium">@tag.Name</span>
                        <span class="text-[9px] text-blue-400">×@tag.QuestionCount</span>
                    </a>
                }
            </div>
        </section>

        <!-- Stack Overflow Yellow Tips Style -->
        <section class="bg-[#fdf7e3] border-l-4 border-yellow-500 rounded-r-lg p-4 shadow-sm">
            <h2 class="text-sm font-bold text-yellow-900 mb-3 flex items-center gap-2">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                Mẹo đặt câu hỏi hay
            </h2>
            <ul class="text-[11px] text-yellow-900 space-y-2">
                <li class="flex items-start gap-2">
                    <span class="text-yellow-600 mt-0.5">•</span>
                    <span><strong>Tiêu đề:</strong> Rõ ràng, cụ thể vấn đề gặp phải</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-yellow-600 mt-0.5">•</span>
                    <span><strong>Code:</strong> Tối giản, dễ tái hiện lỗi</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-yellow-600 mt-0.5">•</span>
                    <span><strong>Bối cảnh:</strong> Đầy đủ log lỗi, version</span>
                </li>
            </ul>
        </section>
    </div>
</aside>

