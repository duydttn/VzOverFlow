@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentUserId = User?.FindFirstValue(ClaimTypes.NameIdentifier);

    string ActiveClass(bool condition) =>
        condition ? "bg-orange-100 text-orange-700 border-r-4 border-orange-500" : "text-slate-600 hover:bg-slate-50";
}

<aside class="hidden md:block md:col-span-2 border-r border-slate-200 min-h-[calc(100vh-4rem)]">
    <div class="sticky top-20 py-4 pr-2">
        <nav class="space-y-0.5 text-[13px]">
            <a asp-controller="Home" asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "Home" && currentAction == "Index")">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                Trang chủ
            </a>

            <a asp-controller="Questions" asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "Questions")">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Câu hỏi
            </a>

            <a asp-controller="Tags" asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "Tags")">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                Thẻ (Tags)
            </a>

            <a asp-controller="Users" asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "Users" && currentAction == "Index")">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                Người dùng
            </a>

            @if (User.IsInRole("Admin"))
            {
                <div class="px-3 py-1 text-[11px] font-semibold text-slate-400 uppercase tracking-wider mt-4">Quản trị</div>
                <a asp-controller="AdminUsers" asp-action="Index"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "AdminUsers")">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    Người dùng
                </a>
                <a asp-controller="Reports" asp-action="Index"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "Reports")">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Báo cáo vi phạm
                </a>
                <a asp-controller="AdminAi" asp-action="Index"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "AdminAi")">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    Cấu hình AI
                </a>
            }

            <hr class="my-3 border-slate-200" />

            <div class="px-3 py-1 text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Khám phá</div>

            <a asp-controller="Chat" asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "Chat")">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                Chat
            </a>

            <a asp-controller="Home" asp-action="Leaderboard"
               class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "Home" && currentAction == "Leaderboard")">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                Bảng xếp hạng
            </a>
            <a asp-controller="Home" asp-action="Badges"
               class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "Home" && currentAction == "Badges")">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                Huy hiệu
            </a>
            <a asp-controller="Home" asp-action="Learn"
               class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "Home" && currentAction == "Learn")">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                Học tập
            </a>

            @if (!string.IsNullOrEmpty(currentUserId))
            {
                <hr class="my-3 border-slate-200" />
                <a asp-controller="Users" asp-action="Profile" asp-route-id="@currentUserId"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-l-md @ActiveClass(currentController == "Users" && currentAction == "Profile")">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    Hồ sơ của tôi
                </a>
            }
        </nav>
    </div>
</aside>