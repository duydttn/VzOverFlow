@model IEnumerable<VzOverFlow.Models.ViewModels.UserProfileViewModel>
@{
    ViewData["Title"] = "Bảng xếp hạng";
    var topUsers = Model.Take(3).ToList();
    var otherUsers = Model.Skip(3).ToList();
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header Section -->
    <div class="text-center mb-16">
        <h1 class="text-4xl md:text-6xl font-black text-slate-900 dark:text-white mb-4 tracking-tight uppercase italic italic-gradient">
            Hall of Fame
        </h1>
        <div class="h-1 w-24 bg-blue-600 mx-auto rounded-full mb-6"></div>
        <p class="text-slate-600 dark:text-slate-400 text-lg max-w-2xl mx-auto font-medium">
            Vinh danh những chiến binh đóng góp xuất sắc nhất cho cộng đồng công nghệ VzOverFlow.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white dark:bg-slate-800 rounded-3xl border border-slate-200 dark:border-slate-700 shadow-sm">
            <div class="text-6xl mb-4">🏆</div>
            <p class="text-slate-600 dark:text-slate-400 font-medium">Chưa có dữ liệu bảng xếp hạng.</p>
        </div>
    }
    else
    {
        <!-- NEW Podium Section (FORCED Horizontal Row) -->
        @if (topUsers.Count > 0)
        {
            <div class="flex flex-row items-end justify-center gap-2 md:gap-8 mb-24 max-w-5xl mx-auto px-2 overflow-visible">
                
                <!-- Rank 2 (Silver) -->
                <div class="flex-1 max-w-[280px]">
                    @if (topUsers.Count >= 2)
                    {
                        <div class="group flex flex-col items-center w-full">
                            <!-- Avatar -->
                            <div class="relative mb-4 transform transition-all duration-500 group-hover:-translate-y-2">
                                <div class="w-16 h-16 md:w-24 md:h-24 rounded-full p-1 bg-slate-200 dark:bg-slate-700 shadow-lg ring-2 md:ring-4 ring-slate-100 dark:ring-slate-800">
                                    <img src="@(topUsers[1].AvatarUrl ?? $"https://api.dicebear.com/7.x/avataaars/svg?seed={topUsers[1].UserName}")" 
                                         alt="@topUsers[1].UserName" 
                                         class="w-full h-full rounded-full object-cover bg-white dark:bg-slate-800" />
                                </div>
                                <div class="absolute -bottom-1 -left-1 md:-bottom-2 md:-left-2 bg-slate-300 dark:bg-slate-600 w-6 h-6 md:w-9 md:h-9 rounded-full flex items-center justify-center text-[10px] md:text-lg shadow-md border-2 border-white dark:border-slate-800 font-bold">
                                    🥈
                                </div>
                            </div>
                            <!-- Pedestal 2 -->
                            <div class="w-full bg-gradient-to-b from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900 rounded-t-2xl shadow-lg border-t-2 border-slate-300 dark:border-slate-600 px-1 py-4 md:py-8 text-center h-32 md:h-56 flex flex-col justify-center min-w-0">
                                <h3 class="text-[9px] md:text-base font-bold text-slate-800 dark:text-white truncate px-1">
                                    <a asp-controller="Users" asp-action="Profile" asp-route-id="@topUsers[1].Id">@topUsers[1].UserName</a>
                                </h3>
                                <div class="mt-1 md:mt-2 text-base md:text-3xl font-black text-slate-700 dark:text-slate-300 font-mono">@topUsers[1].Reputation</div>
                                <span class="text-[7px] md:text-[10px] font-black text-slate-400 uppercase tracking-widest hidden sm:block">RANK 2</span>
                            </div>
                        </div>
                    }
                </div>

                <!-- Rank 1 (Gold) - THE CENTER PILLAR -->
                <div class="flex-1 max-w-[320px] z-10">
                    <div class="group flex flex-col items-center w-full">
                        <!-- Crown & Avatar -->
                        <div class="relative mb-6 transform transition-all duration-700 group-hover:-translate-y-4">
                            <div class="absolute -top-8 md:-top-12 left-1/2 -translate-x-1/2 text-3xl md:text-6xl animate-bounce-slow drop-shadow-2xl opacity-90">👑</div>
                            <div class="w-20 h-20 md:w-36 md:h-36 rounded-full p-1 md:p-1.5 bg-gradient-to-tr from-amber-400 to-yellow-200 shadow-[0_0_30px_rgba(251,191,36,0.3)] ring-2 md:ring-4 ring-amber-100 dark:ring-amber-900/50">
                                <img src="@(topUsers[0].AvatarUrl ?? $"https://api.dicebear.com/7.x/avataaars/svg?seed={topUsers[0].UserName}")" 
                                     alt="@topUsers[0].UserName" 
                                     class="w-full h-full rounded-full object-cover bg-white dark:bg-slate-800" />
                            </div>
                            <div class="absolute -bottom-1 -right-1 md:-bottom-2 md:-right-2 bg-amber-400 text-white w-8 h-8 md:w-12 md:h-12 rounded-full flex items-center justify-center text-xs md:text-2xl shadow-lg border-2 md:border-4 border-white dark:border-slate-900 font-bold">
                                🥇
                            </div>
                        </div>
                        <!-- Pedestal 1 -->
                        <div class="w-full bg-gradient-to-b from-amber-50 to-amber-100 dark:from-amber-900/20 dark:to-slate-900 rounded-t-2xl shadow-2xl border-t-4 border-amber-400 dark:border-amber-500 px-1 py-6 md:py-10 text-center h-44 md:h-72 flex flex-col justify-center relative overflow-hidden min-w-0">
                            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-transparent via-amber-400 to-transparent animate-pulse"></div>
                            <h3 class="text-[10px] md:text-xl font-black text-slate-900 dark:text-white truncate px-1">
                                <a asp-controller="Users" asp-action="Profile" asp-route-id="@topUsers[0].Id">@topUsers[0].UserName</a>
                            </h3>
                            <div class="mt-1 md:mt-2 text-xl md:text-5xl font-black text-amber-600 dark:text-amber-400 font-mono drop-shadow-sm">@topUsers[0].Reputation</div>
                            <span class="text-[7px] md:text-[11px] font-black text-amber-600 dark:text-amber-500 uppercase tracking-[0.2em] font-serif italic mt-1">Champion</span>
                        </div>
                    </div>
                </div>

                <!-- Rank 3 (Bronze) -->
                <div class="flex-1 max-w-[280px]">
                    @if (topUsers.Count >= 3)
                    {
                        <div class="group flex flex-col items-center w-full">
                            <!-- Avatar -->
                            <div class="relative mb-4 transform transition-all duration-500 group-hover:-translate-y-2">
                                <div class="w-16 h-16 md:w-24 md:h-24 rounded-full p-1 bg-orange-100 dark:bg-orange-900/30 shadow-lg ring-2 md:ring-4 ring-orange-50 dark:ring-orange-900/50">
                                    <img src="@(topUsers[2].AvatarUrl ?? $"https://api.dicebear.com/7.x/avataaars/svg?seed={topUsers[2].UserName}")" 
                                         alt="@topUsers[2].UserName" 
                                         class="w-full h-full rounded-full object-cover bg-white dark:bg-slate-800" />
                                </div>
                                <div class="absolute -bottom-1 -left-1 md:-bottom-2 md:-left-2 bg-orange-400 dark:bg-orange-600 w-6 h-6 md:w-9 md:h-9 rounded-full flex items-center justify-center text-[10px] md:text-lg shadow-md border-2 border-white dark:border-slate-800 font-bold">
                                    🥉
                                </div>
                            </div>
                            <!-- Pedestal 3 -->
                            <div class="w-full bg-gradient-to-b from-orange-50 to-orange-100 dark:from-orange-900/10 dark:to-slate-900 rounded-t-2xl shadow-lg border-t-2 border-orange-300 dark:border-orange-700/50 px-1 py-4 md:py-8 text-center h-28 md:h-48 flex flex-col justify-center min-w-0">
                                <h3 class="text-[9px] md:text-base font-bold text-slate-800 dark:text-white truncate px-1">
                                    <a asp-controller="Users" asp-action="Profile" asp-route-id="@topUsers[2].Id">@topUsers[2].UserName</a>
                                </h3>
                                <div class="mt-1 text-base md:text-3xl font-black text-slate-700 dark:text-slate-300 font-mono">@topUsers[2].Reputation</div>
                                <span class="text-[7px] md:text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest hidden sm:block">RANK 3</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        
        <!-- Table Section -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-2xl shadow-slate-200 dark:shadow-none border border-slate-100 dark:border-slate-700 overflow-hidden relative">
            <!-- Decorative corner -->
            <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/5 rounded-full -mr-16 -mt-16"></div>
            
            <div class="p-8 border-b border-slate-50 dark:border-slate-700 flex items-center justify-between bg-slate-50/50 dark:bg-slate-900/30">
                <h2 class="text-xl font-bold text-slate-800 dark:text-white flex items-center gap-3">
                    <span class="w-2 h-6 bg-blue-600 rounded-full"></span>
                    Top Contributors
                </h2>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">All time statistics</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="text-slate-400 dark:text-slate-500 text-[11px] font-black uppercase tracking-widest">
                        <tr>
                            <th class="py-6 px-8 w-24 text-center">Rank</th>
                            <th class="py-6 px-4">Contributor</th>
                            <th class="py-6 px-4 text-center hidden md:table-cell">Activity</th>
                            <th class="py-6 px-8 text-right">Reputation</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 dark:divide-slate-700/50">
                        @foreach (var (user, idx) in Model.Select((u, i) => (u, i + 1)))
                        {
                            <tr class="group hover:bg-blue-50/30 dark:hover:bg-blue-900/10 transition-all duration-300">
                                <td class="py-5 px-8 text-center">
                                    <div class="flex items-center justify-center">
                                        @if (idx <= 3)
                                        {
                                            <span class="w-10 h-10 rounded-full flex items-center justify-center text-xl shadow-sm bg-white dark:bg-slate-700 border border-slate-100 dark:border-slate-600">
                                                @(idx == 1 ? "🥇" : idx == 2 ? "🥈" : "🥉")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="font-mono text-lg font-bold text-slate-400 group-hover:text-blue-600 transition-colors">#@idx</span>
                                        }
                                    </div>
                                </td>
                                <td class="py-5 px-4">
                                    <div class="flex items-center gap-4">
                                        <div class="relative">
                                            <div class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-700 border-2 border-slate-100 dark:border-slate-600 overflow-hidden shadow-sm group-hover:shadow-md transition-all group-hover:-rotate-3">
                                                 <img src="@(user.AvatarUrl ?? $"https://api.dicebear.com/7.x/avataaars/svg?seed={user.UserName}")" 
                                                      alt="@user.UserName" class="w-full h-full object-cover">
                                            </div>
                                            @if(idx <= 10) {
                                                <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 border-2 border-white dark:border-slate-800 rounded-full"></div>
                                            }
                                        </div>
                                        <div>
                                            <a asp-controller="Users" asp-action="Profile" asp-route-id="@user.Id"
                                               class="text-base font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors block leading-tight">
                                                @user.UserName
                                            </a>
                                            <div class="flex items-center gap-2 mt-1">
                                                <span class="inline-flex items-center px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-900/30 text-[10px] font-bold text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-800 uppercase tracking-tighter">
                                                    @(user.Badges.Count) Badges
                                                </span>
                                                <span class="text-[10px] text-slate-400 font-medium">Joined @user.CreatedAt.ToString("MMM yyyy")</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-5 px-4 hidden md:table-cell">
                                    <div class="flex items-center justify-center gap-6">
                                        <div class="text-center">
                                            <div class="text-sm font-black text-slate-700 dark:text-slate-300">@user.QuestionCount</div>
                                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">Questions</div>
                                        </div>
                                        <div class="w-px h-8 bg-slate-100 dark:bg-slate-700"></div>
                                        <div class="text-center">
                                            <div class="text-sm font-black text-slate-700 dark:text-slate-300">@user.AnswerCount</div>
                                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">Answers</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-5 px-8 text-right">
                                    <div class="flex flex-col items-end">
                                        <span class="text-xl font-black text-slate-900 dark:text-white group-hover:text-blue-600 transition-colors font-mono">
                                            @user.Reputation
                                        </span>
                                        <div class="flex items-center gap-1 text-[10px] font-black text-green-500 uppercase tracking-widest">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
                                            </svg>
                                            Stable
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="p-8 bg-slate-50/50 dark:bg-slate-900/30 text-center border-t border-slate-50 dark:border-slate-700">
                 <a asp-controller="Users" asp-action="Index" class="inline-flex items-center gap-2 text-sm font-black text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-all group">
                     Explore All Community Members
                     <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                     </svg>
                 </a>
            </div>
        </div>
    }
</div>

<style>
    @@keyframes bounce-slow {
        0%, 100% { transform: translateY(-8%); }
        50% { transform: translateY(8%); }
    }
    .animate-bounce-slow {
        animation: bounce-slow 4s infinite ease-in-out;
    }
    .italic-gradient {
        background: linear-gradient(135deg, #1e293b 0%, #3b82f6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .dark .italic-gradient {
        background: linear-gradient(135deg, #f8fafc 0%, #60a5fa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>
