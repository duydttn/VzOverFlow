@model VzOverFlow.Models.ViewModels.QuestionListViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

@* Welcome/Success Message after Registration *@
@{
    var welcomeMsg = TempData["WelcomeMessage"] ?? TempData["SuccessMessage"];
}
@if (welcomeMsg != null)
{
    <div class="mb-6 bg-gradient-to-r from-green-50 to-blue-50 border-l-4 border-green-500 rounded-lg p-4 shadow-sm">
        <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <div>
                <h3 class="font-semibold text-green-900 mb-1">@welcomeMsg</h3>
                <p class="text-sm text-green-800">Bạn có thể bắt đầu đặt câu hỏi, trả lời và tương tác với cộng đồng ngay bây giờ!</p>
            </div>
        </div>
    </div>
}


@if (!User.Identity.IsAuthenticated)
{
    <div class="mb-8 rounded-2xl bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-700 p-8 text-white shadow-xl overflow-hidden relative">
        <div class="relative z-10">
            <h2 class="text-3xl font-bold mb-3">Chào mừng bạn đến với VzOverFlow! 🚀</h2>
            <p class="text-blue-100 mb-6 max-w-xl text-lg">
                Cộng đồng hỏi đáp tiếng Việt lớn nhất dành cho lập trình viên. 
                Cùng nhau chia sẻ kiến thức, giải quyết vấn đề và xây dựng sự nghiệp.
            </p>
            <div class="flex flex-wrap gap-4">
                <a asp-controller="Users" asp-action="Register" class="bg-white text-blue-700 px-6 py-2.5 rounded-lg font-bold hover:bg-blue-50 transition-all shadow-lg hover:shadow-white/20">
                    Gia nhập ngay
                </a>
                <a asp-controller="Home" asp-action="Learn" class="bg-blue-500/30 backdrop-blur-md border border-white/20 text-white px-6 py-2.5 rounded-lg font-semibold hover:bg-blue-500/50 transition-all">
                    Khám phá lộ trình học
                </a>
            </div>
        </div>
        @* Decorative elements *@
        <div class="absolute -right-20 -bottom-20 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute right-10 top-10 w-32 h-32 bg-indigo-400/20 rounded-full blur-2xl"></div>
    </div>
}

<div class="mb-6 flex items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900 mb-1">
            Câu hỏi dành cho bạn
        </h1>
        <p class="text-sm text-slate-500">
            Khám phá những nội dung mới nhất và đáng chú ý từ cộng đồng.
        </p>
    </div>
</div>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-2">
    <div class="flex flex-wrap items-center gap-1 text-[13px]">
        @{
            string? currentSort = Context?.Request?.Query["sort"].ToString();
            // Nếu không có sort thì mặc định là trending (do HomeController đã set)
            bool isTrending = string.IsNullOrEmpty(currentSort) || currentSort == "trending";
            
            string activeClass = "bg-blue-50 text-blue-700 font-bold border-b-2 border-blue-600";
            string normalClass = "text-slate-600 hover:text-slate-900 hover:bg-slate-50";
        }
        <a asp-action="Index" asp-route-sort="trending"
           class="px-4 py-2 transition-all @(isTrending ? activeClass : normalClass)">
            🔥 Xu hướng
        </a>
        <a asp-action="Index" asp-route-sort="newest"
           class="px-4 py-2 transition-all @(currentSort == "newest" ? activeClass : normalClass)">
            Mới nhất
        </a>
        <a asp-action="Index" asp-route-sort="active"
           class="px-4 py-2 transition-all @(currentSort == "active" ? activeClass : normalClass)">
            Hoạt động
        </a>
        <a asp-action="Index" asp-route-sort="unanswered"
           class="px-4 py-2 transition-all @(currentSort == "unanswered" ? activeClass : normalClass)">
            Chưa trả lời
        </a>
        <a asp-action="Index" asp-route-sort="votes"
           class="px-4 py-2 transition-all @(currentSort == "votes" ? activeClass : normalClass)">
            Nhiều vote
        </a>
    </div>
</div>

<div class="space-y-3">
    @if (!Model.Questions.Any())
    {
        <div class="bg-white border border-slate-200 rounded-lg p-12 text-center text-slate-500 shadow-sm">
            <svg class="w-16 h-16 mx-auto mb-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="text-lg font-semibold text-slate-800 mb-2">Chưa có câu hỏi nào</h3>
            <p class="mb-6 max-w-sm mx-auto">Hãy là người đầu tiên đặt câu hỏi để khởi tạo cuộc thảo luận sôi nổi cho cộng đồng!</p>
            <a asp-controller="Questions" asp-action="Create" class="inline-flex items-center gap-2 rounded-md bg-blue-600 text-white px-4 py-2 hover:bg-blue-700 transition-colors font-medium">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Đặt câu hỏi ngay
            </a>
        </div>
    }
    else
    {
        foreach (var q in Model.Questions)
        {
            @await Html.PartialAsync("_QuestionCard", q)
        }
    }
</div>
