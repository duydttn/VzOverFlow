@model IEnumerable<VzOverFlow.Models.AiConfig>
@{
    ViewData["Title"] = "Cấu hình AI";
}

<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-3xl font-bold text-slate-900">🤖 Cấu hình AI</h1>
        <p class="text-slate-600">Quản lý các API Key cho Gemini, ChatGPT và các dịch vụ AI khác.</p>
    </div>
    <a asp-action="Create" class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700 transition-all shadow-md">
        <span>+ Thêm Key mới</span>
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm shadow-sm transition-all">
        @TempData["SuccessMessage"]
    </div>
}

<div class="grid grid-cols-1 gap-6">
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Provider</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">API Key</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Trạng thái</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Sử dụng</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Lần cuối</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @foreach (var item in Model)
                    {
                        var providerColor = item.Provider switch
                        {
                            "Gemini" => "bg-blue-100 text-blue-700",
                            "OpenAI" => "bg-emerald-100 text-emerald-700",
                            _ => "bg-slate-100 text-slate-700"
                        };

                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-widest @providerColor">
                                        @item.Provider
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.ModelName))
                                    {
                                        <span class="text-xs text-slate-400 font-mono">(@item.ModelName)</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm font-mono text-slate-600">
                                    @(item.ApiKey.Length > 8 ? $"{item.ApiKey.Substring(0, 4)}...{item.ApiKey.Substring(item.ApiKey.Length - 4)}" : "********")
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <form asp-action="Toggle" asp-route-id="@item.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="inline-flex items-center gap-1">
                                        @if (item.IsActive)
                                        {
                                            <span class="w-2 h-2 rounded-full bg-green-500"></span>
                                            <span class="text-xs font-bold text-green-700">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="w-2 h-2 rounded-full bg-slate-300"></span>
                                            <span class="text-xs font-bold text-slate-400">Đã tắt</span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td class="px-6 py-4 text-sm font-bold text-slate-700">
                                @item.UsageCount
                            </td>
                            <td class="px-6 py-4 text-xs text-slate-500">
                                @(item.LastUsedAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "Chưa dùng")
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="p-2 text-slate-400 hover:text-blue-600 transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa cấu hình này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-2 text-slate-400 hover:text-red-500 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="p-12 text-center text-slate-400 italic">
                Chưa có cấu hình AI nào được tạo.
            </div>
        }
    </div>
</div>  