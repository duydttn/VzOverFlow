@model VzOverFlow.Models.ViewModels.QuestionListViewModel
@{
    ViewData["Title"] = "Tất cả câu hỏi";
}

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900 mb-1">
            Tất cả câu hỏi
        </h1>
        <p class="text-sm text-slate-500">
            Khám phá kho tri thức từ cộng đồng lập trình viên.
        </p>
    </div>
    
    <div class="flex items-center gap-2">
        @{
            string? currentSort = Context?.Request?.Query["sort"].ToString();
            string activeBtn = "bg-slate-900 text-white shadow-md shadow-slate-200";
            string normalBtn = "bg-white text-slate-600 border border-slate-200 hover:bg-slate-50";
        }
        <a asp-action="Index" asp-route-sort="newest" asp-route-search="@Model.Search" asp-route-tag="@Model.Tag"
           class="px-3 py-1.5 rounded-md text-xs font-medium transition-all @(string.IsNullOrEmpty(currentSort) || currentSort == "newest" ? activeBtn : normalBtn)">
            Mới nhất
        </a>
        <a asp-action="Index" asp-route-sort="votes" asp-route-search="@Model.Search" asp-route-tag="@Model.Tag"
           class="px-3 py-1.5 rounded-md text-xs font-medium transition-all @(currentSort == "votes" ? activeBtn : normalBtn)">
            Nhiều vote
        </a>
    </div>
</div>

<form method="get" class="mb-6">
    <div class="flex flex-wrap gap-3 items-center">
        <!-- Search input - takes more space -->
        <div class="flex-1 min-w-[200px] relative group">
            @*
            <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 group-focus-within:text-blue-500 transition-colors pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            *@
            <input name="search" value="@Model.Search" 
                   class="w-full pl-10 pr-4 py-2.5 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all shadow-sm dark:text-white dark:placeholder-slate-400" 
                   placeholder="Tìm theo tên hoặc nội dung..." />
        </div>
        
        <!-- Tag input - shorter -->
        <div class="w-48 relative group">
            @*
            <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 group-focus-within:text-blue-500 transition-colors pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            *@
            <input name="tag" value="@Model.Tag" 
                   class="w-full pl-10 pr-4 py-2.5 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all shadow-sm dark:text-white dark:placeholder-slate-400" 
                   placeholder="Tag" />
        </div>
        
        <input type="hidden" name="sort" value="@currentSort" />
        
        <!-- Buttons -->
        <button type="submit" class="bg-blue-600 text-white rounded-full px-6 py-2.5 text-sm font-medium hover:bg-blue-700 transition-colors shadow-sm hover:shadow-md">
            Lọc
        </button>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Tag))
        {
            <a asp-action="Index" class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-full px-5 py-2.5 text-sm font-medium hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                Xóa
            </a>
        }
    </div>
</form>


<div class="space-y-3">
    @foreach (var q in Model.Questions)
    {
        @await Html.PartialAsync("_QuestionCard", q)
    }
</div>