@model VzOverFlow.Models.ViewModels.QuestionCreateViewModel
@{
    ViewData["Title"] = "Đặt câu hỏi";
}

<div class="mb-8">
    <h1 class="text-2xl md:text-3xl font-semibold text-slate-900 mb-2">
        Đặt câu hỏi
    </h1>
    <p class="text-sm text-slate-600">
        Chia sẻ vấn đề bạn gặp phải và nhận sự giúp đỡ từ cộng đồng VzOverFlow.
    </p>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg">
        @TempData["ErrorMessage"]
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg">
        <strong>Có lỗi xảy ra:</strong>
        <ul class="list-disc list-inside mt-2">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-action="Create" method="post" id="ask-question-form">
    @Html.AntiForgeryToken()
    <div class="w-full">
        <div class="space-y-6">
            <div class="bg-white border border-slate-200 rounded-lg p-8 shadow-sm">
                <div class="mb-4">
                    <label asp-for="Title" class="block text-sm font-semibold text-slate-800 mb-1">
                        Tiêu đề <span class="text-red-500">*</span>
                    </label>
                    <p class="text-xs text-slate-500 mb-2">
                        Hãy tóm tắt rõ ràng vấn đề của bạn trong một câu.
                    </p>
                    <input asp-for="Title"
                           class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="Title" class="text-xs text-red-500"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Body" class="block text-sm font-semibold text-slate-800 mb-1">
                        Nội dung chi tiết <span class="text-red-500">*</span>
                    </label>
                    <p class="text-xs text-slate-500 mb-2">
                        Mô tả chi tiết vấn đề, ngữ cảnh, mã nguồn (nếu có) và những gì bạn đã thử.
                    </p>
                    <textarea asp-for="Body" rows="10"
                              class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                    <span asp-validation-for="Body" class="text-xs text-red-500"></span>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-800 mb-1">
                        Thẻ (Tags)
                    </label>
                    <p class="text-xs text-slate-500 mb-2">
                        Thêm tối đa 5 thẻ, cách nhau bởi khoảng trắng. Ví dụ: <code class="bg-slate-100 px-1 rounded">c# asp.net-core entity-framework</code>
                    </p>
                    <input asp-for="Tags"
                           class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div class="flex items-center justify-between pt-2">
                    <a asp-action="Index"
                       class="text-xs text-slate-500 hover:text-slate-700">
                        Hủy và quay lại danh sách
                    </a>
                    <div class="flex gap-3">
                         <button type="button" id="btn-check-duplicate"
                                class="inline-flex items-center gap-2 rounded-md bg-white border border-slate-300 text-slate-700 text-sm px-4 py-2 hover:bg-slate-50 shadow-sm transition-colors">
                            Đăng câu hỏi
                        </button>
                        <button type="submit" id="btn-submit-question" style="display: none;"
                                class="inline-flex items-center gap-2 rounded-md bg-blue-600 text-white text-sm px-4 py-2 hover:bg-blue-700 shadow-sm transition-colors">
                            Đăng câu hỏi
                        </button>
                    </div>
                </div>
            </div>
            
             <!-- AI Suggestion Panel -->
            <div id="ai-suggestion-panel" class="hidden bg-yellow-50 border border-yellow-200 rounded-lg p-5 mt-4 transition-all duration-300">
                <div class="flex items-start gap-3">
                    <span class="text-2xl">🧐</span>
                    <div class="flex-1">
                        <h3 class="text-sm font-bold text-yellow-800 mb-1">
                            Có vẻ câu hỏi này đã tồn tại?
                        </h3>
                        <p class="text-xs text-yellow-700 mb-3">
                            AI phát hiện một số câu hỏi tương tự có thể đã có câu trả lời bạn cần. Hãy kiểm tra trước khi đăng nhé!
                        </p>
                        
                        <div id="ai-suggestion-list" class="space-y-2 mb-4">
                            <!-- Items inserted via JS -->
                        </div>

                        <div class="flex gap-2">
                            <button type="button" id="btn-cancel-post" class="text-xs text-slate-600 hover:text-slate-800 bg-white border border-slate-300 rounded px-3 py-1.5 shadow-sm">
                                Ừm, để tôi xem lại
                            </button>
                            <button type="button" id="btn-force-submit" class="text-xs text-slate-900 bg-yellow-400 hover:bg-yellow-500 font-medium rounded px-3 py-1.5 shadow-sm transition-colors border border-yellow-500">
                                Không, câu hỏi của tôi khác. Đăng luôn!
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</form>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
    <script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Markdown Editor
            const easyMDE = new EasyMDE({ 
                element: document.getElementById('Body'),
                spellChecker: false,
                placeholder: "Mô tả chi tiết vấn đề của bạn...",
                toolbar: ["bold", "italic", "heading", "|", "quote", "code", "unordered-list", "ordered-list", "|", "link", "image", "|", "preview", "side-by-side", "fullscreen", "|", "guide"]
            });

            const btnCheck = document.getElementById('btn-check-duplicate');
            const btnSubmit = document.getElementById('btn-submit-question');
            const btnForceSubmit = document.getElementById('btn-force-submit');
            const btnCancel = document.getElementById('btn-cancel-post');
            const panel = document.getElementById('ai-suggestion-panel');
            const list = document.getElementById('ai-suggestion-list');
            const titleInput = document.getElementById('Title');
            const form = document.getElementById('ask-question-form');

            btnCheck.addEventListener('click', async function() {
                const title = titleInput.value.trim();
                const body = easyMDE.value().trim();

                if (!title || !body) {
                    alert('Vui lòng nhập tiêu đề và nội dung trước khi kiểm tra.');
                    return;
                }

                // UI Loading state
                const originalText = btnCheck.innerHTML;
                btnCheck.innerHTML = '⏳ Đang phân tích...';
                btnCheck.disabled = true;
                panel.classList.add('hidden');

                try {
                    const response = await fetch('/Questions/CheckDuplicate', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({ title, body })
                    });

                    if (!response.ok) throw new Error('API Error');

                    const data = await response.json();

                    if (data && data.length > 0) {
                        renderSuggestions(data);
                        panel.classList.remove('hidden');
                        btnCheck.classList.add('hidden');
                    } else {
                        btnCheck.classList.add('hidden');
                        btnSubmit.style.display = 'inline-flex';
                    }

                } catch (error) {
                    console.error(error);
                    alert('Không thể kiểm tra trùng lặp lúc này. Bạn cứ đăng đi!');
                    btnCheck.classList.add('hidden');
                    btnSubmit.style.display = 'inline-flex';
                } finally {
                    btnCheck.innerHTML = originalText;
                    btnCheck.disabled = false;
                }
            });

            function renderSuggestions(items) {
                list.innerHTML = items.map(item => `
                    <div class="bg-white p-3 rounded border border-yellow-100 hover:border-yellow-300 transition-colors">
                        <a href="${item.url}" target="_blank" class="font-semibold text-blue-700 hover:underline block mb-1">
                            ${item.title}
                        </a>
                        <div class="flex gap-3 text-[11px] text-slate-500">
                            <span class="${item.hasAcceptedAnswer ? 'text-green-600 font-bold' : ''}">
                                ${item.hasAcceptedAnswer ? '✓ Đã giải quyết' : 'Chưa giải quyết'}
                            </span>
                            <span>• ${item.answerCount} câu trả lời</span>
                        </div>
                    </div>
                `).join('');
            }

            btnForceSubmit.addEventListener('click', function() {
                btnSubmit.click(); 
            });

            btnCancel.addEventListener('click', function() {
               panel.classList.add('hidden');
               btnCheck.classList.remove('hidden');
            });
        });
    </script>
}