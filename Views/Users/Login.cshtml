@model VzOverFlow.Models.ViewModels.LoginViewModel
@inject Microsoft.AspNetCore.Identity.SignInManager<VzOverFlow.Models.User> SignInManager
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
    var externalProviders = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
}

<div class="bg-white border border-slate-200 rounded-lg p-6 shadow-sm">
    <h1 class="text-2xl font-semibold text-slate-900 mb-1 text-center">Đăng nhập</h1>
    <p class="text-sm text-slate-600 mb-6 text-center">
        Chào mừng trở lại VzOverFlow
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">
            @ViewBag.Error
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">
            @TempData["Error"]
        </div>
    }

    <form asp-action="Login" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-xs text-red-500"></div>

        <div>
            <label asp-for="UserNameOrEmail" class="block text-sm font-medium text-slate-800 mb-1">Tên đăng nhập hoặc email</label>
            <input asp-for="UserNameOrEmail"
                   class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                   placeholder="username hoặc email" />
            <span asp-validation-for="UserNameOrEmail" class="text-xs text-red-500"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-slate-800 mb-1">Mật khẩu</label>
            <input asp-for="Password" type="password"
                   class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
            <span asp-validation-for="Password" class="text-xs text-red-500"></span>
        </div>

        <button type="submit"
                class="w-full rounded-md bg-slate-900 text-white text-sm px-3 py-2 hover:bg-slate-800">
            Đăng nhập
        </button>
    </form>

    @if (externalProviders.Any())
    {
        <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-slate-200"></div>
            </div>
            <div class="relative flex justify-center text-xs">
                <span class="bg-white px-2 text-slate-500">Hoặc đăng nhập với</span>
            </div>
        </div>

        <div class="space-y-2">
            @foreach (var provider in externalProviders)
            {
                <form asp-action="ExternalLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="@provider.Name" />
                    <button type="submit" class="w-full flex items-center justify-center gap-2 rounded-md border border-slate-200 px-3 py-2 text-sm font-medium hover:bg-slate-50 transition-colors @GetProviderClass(provider.Name)">
                        @GetProviderIcon(provider.Name)
                        <span>Đăng nhập với @provider.DisplayName</span>
                    </button>
                </form>
            }
        </div>
    }

    <p class="text-xs text-slate-500 mt-4 text-center">
        Chưa có tài khoản?
        <a asp-action="Register" class="text-blue-600 hover:underline">Đăng ký ngay</a>
    </p>
</div>

@functions {
    string GetProviderClass(string provider) => provider.ToLower() switch
    {
        "google" => "text-slate-700",
        "facebook" => "text-[#1877F2]",
        "github" => "text-slate-900",
        _ => "text-slate-700"
    };

    Microsoft.AspNetCore.Html.IHtmlContent GetProviderIcon(string provider)
    {
        var svg = provider.ToLower() switch
        {
            "google" => @"<svg class=""h-5 w-5"" viewBox=""0 0 24 24""><path fill=""#4285F4"" d=""M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z""/><path fill=""#34A853"" d=""M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z""/><path fill=""#FBBC05"" d=""M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z""/><path fill=""#EA4335"" d=""M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z""/></svg>",
            "facebook" => @"<svg class=""h-5 w-5"" fill=""#1877F2"" viewBox=""0 0 24 24""><path d=""M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z""/></svg>",
            "github" => @"<svg class=""h-5 w-5"" fill=""currentColor"" viewBox=""0 0 24 24""><path d=""M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z""/></svg>",
            _ => @"<svg class=""h-5 w-5"" fill=""none"" viewBox=""0 0 24 24"" stroke=""currentColor""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z""/></svg>"
        };
        return new Microsoft.AspNetCore.Html.HtmlString(svg);
    }
}