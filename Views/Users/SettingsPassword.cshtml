@model VzOverFlow.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="max-w-3xl mx-auto space-y-6">
    @await Html.PartialAsync("_SettingsNav")

    <div class="bg-white border border-slate-200 rounded-lg p-5 shadow-sm">
        <h1 class="text-2xl font-semibold text-slate-900 mb-2">Đổi mật khẩu</h1>
        <p class="text-sm text-slate-600">Bảo vệ tài khoản bằng mật khẩu mạnh.</p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
             <div class="mt-3 rounded-md border border-blue-200 bg-blue-50 text-blue-800 px-3 py-2 text-xs">
                @Model.StatusMessage
            </div>
        }
        
        <!-- Toast notification -->
        <div id="otpToast" class="hidden mt-3 rounded-md px-3 py-2 text-xs transition-all"></div>
    </div>

    <div class="bg-white border border-slate-200 rounded-lg p-5 shadow-sm space-y-4">
        <h2 class="text-lg font-semibold text-slate-900">Thay đổi mật khẩu</h2>
        <p class="text-xs text-slate-500">
            Mật khẩu phải có ít nhất 6 ký tự và chứa số.
        </p>

        <form asp-controller="Users" asp-action="ChangePassword" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TwoFactorEnabled" />
            
            <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">Mật khẩu hiện tại</label>
                <input name="OldPassword" type="password" required
                       class="w-full rounded-md border border-slate-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">Mật khẩu mới</label>
                <input name="NewPassword" type="password" required minlength="6"
                       class="w-full rounded-md border border-slate-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">Xác nhận mật khẩu mới</label>
                <input name="ConfirmPassword" type="password" required
                       class="w-full rounded-md border border-slate-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            @if (Model.TwoFactorEnabled) {
                 <div class="border-t border-slate-200 pt-3 mt-3">
                    <label class="block text-xs font-medium text-slate-700 mb-1">Mã xác nhận (OTP)</label>
                    <p class="text-xs text-slate-500 mb-2">Do bạn đang bật 2FA, vui lòng nhập mã OTP để đổi mật khẩu.</p>
                    
                    <div class="flex gap-2">
                        <input name="OtpCode" type="text" placeholder="Nhập mã OTP" id="otpInput"
                           class="w-full rounded-md border border-slate-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        
                        <button type="button" id="requestOtpBtn"
                                class="whitespace-nowrap rounded-md bg-slate-100 text-slate-700 px-3 py-2 hover:bg-slate-200 text-xs font-medium flex items-center gap-2">
                            <span id="otpBtnText">Lấy mã OTP</span>
                            <svg id="otpSpinner" class="hidden animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        </button>
                    </div>
                 </div>
            }

            <button type="submit"
                    class="w-full rounded-md bg-blue-600 text-white px-4 py-2 hover:bg-blue-700 font-medium">
                Đổi mật khẩu
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var requestBtn = document.getElementById('requestOtpBtn');
            if (!requestBtn) return;
            
            var btnText = document.getElementById('otpBtnText');
            var spinner = document.getElementById('otpSpinner');
            var toast = document.getElementById('otpToast');
            var otpInput = document.getElementById('otpInput');
            
            requestBtn.addEventListener('click', async function() {
                // Show loading state
                requestBtn.disabled = true;
                btnText.textContent = 'Đang gửi...';
                spinner.classList.remove('hidden');
                
                try {
                    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    
                    var response = await fetch('@Url.Action("RequestChangePasswordOtp", "Users")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: '__RequestVerificationToken=' + encodeURIComponent(token)
                    });
                    
                    var data = await response.json();
                    
                    // Show toast
                    toast.classList.remove('hidden', 'bg-green-50', 'border-green-200', 'text-green-800', 'bg-red-50', 'border-red-200', 'text-red-800');
                    
                    if (data.success) {
                        toast.classList.add('bg-green-50', 'border', 'border-green-200', 'text-green-800');
                        toast.innerHTML = '✓ ' + data.message;
                        otpInput.focus();
                    } else {
                        toast.classList.add('bg-red-50', 'border', 'border-red-200', 'text-red-800');
                        toast.innerHTML = '✗ ' + data.message;
                    }
                    
                    // Auto hide toast after 5s
                    setTimeout(function() {
                        toast.classList.add('hidden');
                    }, 5000);
                    
                } catch (error) {
                    toast.classList.remove('hidden');
                    toast.classList.add('bg-red-50', 'border', 'border-red-200', 'text-red-800');
                    toast.innerHTML = '✗ Có lỗi xảy ra. Vui lòng thử lại.';
                } finally {
                    // Reset button
                    requestBtn.disabled = false;
                    btnText.textContent = 'Lấy mã OTP';
                    spinner.classList.add('hidden');
                }
            });
        });
    </script>
}