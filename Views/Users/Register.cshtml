@model VzOverFlow.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_AuthLayout";
}

<div class="bg-white border border-slate-200 rounded-lg p-6 shadow-sm">
    <h1 class="text-2xl font-semibold text-slate-900 mb-1 text-center">Đăng ký</h1>
    <p class="text-sm text-slate-600 mb-6 text-center">
        Tạo tài khoản để tham gia cộng đồng VzOverFlow
    </p>

    <form asp-action="Register" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="UserName" class="block text-sm font-medium text-slate-800 mb-1">Tên đăng nhập</label>
            <input asp-for="UserName"
                   class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
            <span asp-validation-for="UserName" class="text-xs text-red-500"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-slate-800 mb-1">
                Email <span class="text-red-500">*</span>
            </label>
            <input asp-for="Email" type="email" required
                   placeholder="your@email.com"
                   class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
            <span asp-validation-for="Email" class="text-xs text-red-500"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-slate-800 mb-1">Mật khẩu</label>
            <input asp-for="Password" type="password" id="InputPassword"
                   class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
            <span asp-validation-for="Password" class="text-xs text-red-500"></span>
            
            <!-- Password Requirements Hints -->
            <div id="passwordHints" class="mt-2 p-3 bg-slate-50 rounded-md border border-slate-200 text-xs hidden">
                <p class="font-medium text-slate-700 mb-2">Yêu cầu mật khẩu:</p>
                <ul class="space-y-1">
                    <li id="hint-length" class="flex items-center gap-2 text-slate-500">
                        <span class="hint-icon">○</span>
                        <span>Ít nhất 6 ký tự</span>
                    </li>
                    <li id="hint-digit" class="flex items-center gap-2 text-slate-500">
                        <span class="hint-icon">○</span>
                        <span>Có ít nhất 1 chữ số (0-9)</span>
                    </li>
                </ul>
            </div>
        </div>

        <div id="ConfirmPasswordSection" style="display:none;">
            <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-800 mb-1">Xác nhận mật khẩu</label>
            <input asp-for="ConfirmPassword" type="password" id="InputConfirmPassword"
                   class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500"></span>
            <p id="confirmHint" class="mt-1 text-xs text-red-500 hidden">Mật khẩu xác nhận không khớp</p>
        </div>

        <button type="submit"
                class="w-full rounded-md bg-slate-900 text-white text-sm px-3 py-2 hover:bg-slate-800">
            Đăng ký
        </button>
    </form>

    <p class="text-xs text-slate-500 mt-4 text-center">
        Đã có tài khoản?
        <a asp-action="Login" class="text-blue-600 hover:underline">Đăng nhập</a>
    </p>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var passwordInput = document.getElementById("InputPassword");
            var confirmInput = document.getElementById("InputConfirmPassword");
            var confirmSection = document.getElementById("ConfirmPasswordSection");
            var passwordHints = document.getElementById("passwordHints");
            var confirmHint = document.getElementById("confirmHint");

            var hintLength = document.getElementById("hint-length");
            var hintDigit = document.getElementById("hint-digit");

            function validatePassword() {
                var password = passwordInput.value;
                var isValid = true;

                // Show hints when typing
                if (password.length > 0) {
                    passwordHints.classList.remove("hidden");
                    confirmSection.style.display = "block";
                } else {
                    passwordHints.classList.add("hidden");
                    confirmSection.style.display = "none";
                }

                // Check length >= 6
                if (password.length >= 6) {
                    hintLength.classList.remove("text-slate-500");
                    hintLength.classList.add("text-green-600");
                    hintLength.querySelector(".hint-icon").textContent = "✓";
                } else {
                    hintLength.classList.add("text-slate-500");
                    hintLength.classList.remove("text-green-600");
                    hintLength.querySelector(".hint-icon").textContent = "○";
                    isValid = false;
                }

                // Check has digit
                if (/\d/.test(password)) {
                    hintDigit.classList.remove("text-slate-500");
                    hintDigit.classList.add("text-green-600");
                    hintDigit.querySelector(".hint-icon").textContent = "✓";
                } else {
                    hintDigit.classList.add("text-slate-500");
                    hintDigit.classList.remove("text-green-600");
                    hintDigit.querySelector(".hint-icon").textContent = "○";
                    isValid = false;
                }

                // Update border color
                if (password.length === 0) {
                    passwordInput.classList.remove("border-red-500", "border-green-500");
                    passwordInput.classList.add("border-slate-200");
                } else if (isValid) {
                    passwordInput.classList.remove("border-red-500", "border-slate-200");
                    passwordInput.classList.add("border-green-500");
                } else {
                    passwordInput.classList.remove("border-green-500", "border-slate-200");
                    passwordInput.classList.add("border-red-500");
                }

                validateConfirmPassword();
            }

            function validateConfirmPassword() {
                var password = passwordInput.value;
                var confirmPassword = confirmInput.value;

                if (confirmPassword.length === 0) {
                    confirmInput.classList.remove("border-red-500", "border-green-500");
                    confirmInput.classList.add("border-slate-200");
                    confirmHint.classList.add("hidden");
                } else if (password === confirmPassword) {
                    confirmInput.classList.remove("border-red-500", "border-slate-200");
                    confirmInput.classList.add("border-green-500");
                    confirmHint.classList.add("hidden");
                } else {
                    confirmInput.classList.remove("border-green-500", "border-slate-200");
                    confirmInput.classList.add("border-red-500");
                    confirmHint.classList.remove("hidden");
                }
            }

            passwordInput.addEventListener("input", validatePassword);
            passwordInput.addEventListener("focus", function() {
                if (passwordInput.value.length > 0) {
                    passwordHints.classList.remove("hidden");
                }
            });
            confirmInput.addEventListener("input", validateConfirmPassword);

            validatePassword();
        });
    </script>
}