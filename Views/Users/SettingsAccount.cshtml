@model VzOverFlow.Models.ViewModels.AccountSettingsViewModel
@{
    ViewData["Title"] = "Cài đặt tài khoản";
}

<div class="max-w-3xl mx-auto space-y-6">
    @await Html.PartialAsync("_SettingsNav")

    <div class="bg-white border border-slate-200 rounded-lg p-5 shadow-sm">
        <h1 class="text-2xl font-semibold text-slate-900 mb-2">Cài đặt tài khoản</h1>
        <p class="text-sm text-slate-600">
            Quản lý thông tin đăng nhập, email nhận thông báo và Tên hiển thị trên hồ sơ.
        </p>
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="mt-3 rounded-md border border-green-200 bg-green-50 px-3 py-2 text-xs text-green-800">
                @Model.StatusMessage
            </div>
        }
    </div>

    <section class="bg-white border border-slate-200 rounded-lg p-5 shadow-sm text-sm space-y-4">
        <h2 class="text-base font-semibold text-slate-900">thông tin tài khoản</h2>
        <form asp-action="AccountSettings" method="post" class="space-y-4" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div>
                <label asp-for="UserName" class="block text-xs font-semibold text-slate-600 mb-1"></label>
                <input asp-for="UserName"
                       class="w-full rounded-md border border-slate-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="UserName" class="text-xs text-red-500"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-slate-600 mb-1"></label>
                <input asp-for="Email"
                       class="w-full rounded-md border border-slate-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="Email" class="text-xs text-red-500"></span>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Ảnh đại diện</label>
                <div class="flex items-center gap-4">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar" class="h-12 w-12 rounded-full object-cover border border-slate-200" />
                    }
                    <div class="flex-1">
                         <input asp-for="AvatarFile" type="file" accept="image/*"
                               class="w-full text-sm text-slate-500
                                      file:mr-4 file:py-2 file:px-4
                                      file:rounded-md file:border-0
                                      file:text-sm file:font-semibold
                                      file:bg-blue-50 file:text-blue-700
                                      hover:file:bg-blue-100" />
                         <span asp-validation-for="AvatarFile" class="text-xs text-red-500"></span>
                         <p class="text-[10px] text-slate-400 mt-1">Chọn ảnh JPG, PNG. Tối đa 2MB.</p>
                    </div>
                </div>
                <!-- Hidden input if we want to preserve URL when no new file is uploaded, though logic usually handles null file = keep old -->
            </div>

            <div>
                <label asp-for="Bio" class="block text-xs font-semibold text-slate-600 mb-1"></label>
                <textarea asp-for="Bio" rows="4" placeholder="Chia sẻ một chút về bản thân..."
                       class="w-full rounded-md border border-slate-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"></textarea>
                <span asp-validation-for="Bio" class="text-xs text-red-500"></span>
            </div>

            <p class="text-xs text-slate-500">
                Email này được dùng để đăng nhập và nhận mã OTP. Hãy đảm bảo bạn có quyền truy cập hộp thư.
            </p>

            <div class="flex justify-end">
                <button type="submit"
                        class="inline-flex items-center rounded-md bg-blue-600 text-white px-4 py-2 text-sm hover:bg-blue-700">
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </section>

    <section class="bg-white border border-slate-200 rounded-lg p-5 shadow-sm text-xs text-slate-600 space-y-2">
        <h2 class="text-sm font-semibold text-slate-900">Ghi chú</h2>
        <p>- Khi đổi email, bạn sẽ dùng email mới cho lần đăng nhập tiếp theo.</p>
        <p>- Nếu bạn bật 2FA, OTP cũng sẽ gửi về địa chỉ email này.</p>
        <p>- Liên hệ quản trị viên nếu bạn muốn xoá tài khoản hoặc thay đổi thông tin khác.</p>
    </section>
</div>