@model IEnumerable<VzOverFlow.Models.User>
@{
    ViewData["Title"] = "Danh sách người dùng";
    var search = Context.Request.Query["search"].ToString();
    var sort = Context.Request.Query["sort"].ToString();
    if (string.IsNullOrEmpty(sort)) sort = "reputation";
}

<div class="mb-6">
    <h1 class="text-3xl font-bold text-slate-900 mb-2">
        Người dùng
    </h1>
    <p class="text-sm text-slate-600">
        Khám phá những thành viên đang đóng góp nhiều cho cộng đồng VzOverFlow.
    </p>
</div>

<form method="get" class="mb-4">
    <div class="flex flex-wrap items-center gap-2">
        <div class="relative flex-1 min-w-[250px] group">
            <input name="search"
                   value="@search"
                   class="w-full rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 pl-10 transition-all shadow-sm dark:text-white dark:placeholder-slate-400"
                   placeholder="Tìm theo tên người dùng..." />
            @*
            <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 group-focus-within:text-blue-500 transition-colors pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            *@
        </div>
        <input type="hidden" name="sort" value="@sort" />
        <button type="submit"
                class="rounded-md bg-blue-600 text-white px-4 py-2.5 text-sm hover:bg-blue-700 font-medium">
            Tìm kiếm
        </button>
    </div>
</form>

<!-- Filter Tabs -->
<!-- Filter Tabs -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-2">
    <div class="flex flex-wrap items-center gap-1 text-[13px]">
        @{
            string activeClass = "bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 font-bold border-b-2 border-blue-600 dark:border-blue-500";
            string normalClass = "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800";
        }
        <a href="?sort=reputation&search=@search" 
           class="px-4 py-2 transition-all @(sort == "reputation" ? activeClass : normalClass)">
            Uy tín cao
        </a>
        <a href="?sort=newest&search=@search" 
           class="px-4 py-2 transition-all @(sort == "newest" ? activeClass : normalClass)">
            Mới nhất
        </a>
        <a href="?sort=name&search=@search" 
           class="px-4 py-2 transition-all @(sort == "name" ? activeClass : normalClass)">
            Theo tên
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="bg-white border border-slate-200 rounded-lg p-6 text-center">
        <svg class="h-12 w-12 text-slate-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <p class="text-sm text-slate-600">Chưa có người dùng nào hoặc không tìm thấy.</p>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        @foreach (var u in Model)
        {
            var avatarUrl = !string.IsNullOrEmpty(u.AvatarUrl) ? u.AvatarUrl : $"https://api.dicebear.com/7.x/avataaars/svg?seed={u.UserName}";
            <a asp-action="Profile" asp-route-id="@u.Id"
               class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg p-5 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-md transition-all flex flex-col gap-3 group h-full">
                
                <div class="flex items-start justify-between">
                    <div class="flex items-center gap-3">
                         <img src="@avatarUrl" alt="@u.UserName" class="h-12 w-12 rounded-full bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 object-cover flex-shrink-0" />
                         <div class="min-w-0">
                            <h3 class="font-bold text-base text-blue-700 dark:text-blue-400 group-hover:underline truncate">
                                @u.UserName
                            </h3>
                            <span class="text-xs text-slate-500 dark:text-slate-400">
                                Tham gia @(u.CreatedAt.ToLocalTime() > DateTime.Now.AddDays(-7) ? "mới đây" : u.CreatedAt.ToString("MMM yyyy"))
                            </span>
                         </div>
                    </div>
                </div>

                <div class="flex items-center gap-4 mt-auto border-t border-slate-100 dark:border-slate-700 pt-3">
                    <div class="flex flex-col">
                        <span class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">Uy tín</span>
                        <span class="text-sm font-bold text-slate-900 dark:text-slate-100">@u.Reputation</span>
                    </div>
                    
                    @if(u.Badges != null && u.Badges.Any()) {
                        <div class="flex flex-col border-l border-slate-100 dark:border-slate-700 pl-4">
                            <span class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold">Huy hiệu</span>
                            <div class="flex gap-1 items-center">
                                <span class="text-sm font-bold text-slate-900 dark:text-slate-100">@u.Badges.Count</span>
                                <span class="text-[10px] text-amber-500">🏆</span>
                            </div>
                        </div>
                    }
                </div>
            </a>
        }
    </div>
}